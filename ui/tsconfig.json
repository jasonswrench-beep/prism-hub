{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ES2020",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "rootDir": "src",
    "outDir": "js",
    "sourceMap": false,
    "removeComments": false
  },
  "include": ["src/**/*.ts"]
}
